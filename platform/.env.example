# Local default. Copy to .env; never commit secrets.
APP_ORIGIN=http://127.0.0.1:8765
APP_HOST=127.0.0.1
APP_PORT=8765
MAX_UPLOAD_MB=512
# Default persistent data directory: platform/runtime
# COURSE_DATA_DIR=D:/course-data
# Optional OpenAI-compatible chat completions service (base includes /v1).
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=
# AI_MODEL=

# SiliconFlow fixed-model integration (optional; never commit a real key).
# SILICONFLOW_API_KEY=
# Local alternative: put the key on one line in COURSE_DATA_DIR/siliconflow.key
